# Copy to .env and fill in. .env is git-ignored and must never be committed.
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Lesson authoring assistant. Without a key the app still works: lesson drafting falls back
# to a deterministic rule-based generator and says so in the UI.
AI_ENABLED=True
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
